# Copy to .env and fill in real values. Never commit .env.

# --- Telegram (required) ---
# Obtain from @BotFather: /newbot
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here
# Numeric channel id (negative for channels). Get via @getidsbot or Bot API getChat.
TELEGRAM_CHANNEL_ID=-1001234567890
# Bot username without @ — used to build ad final URLs (https://t.me/<bot>?start=<token>).
BOT_USERNAME=your_bot_username
# Comma-separated Telegram user IDs allowed to run admin commands.
ADMIN_USER_IDS=123456789

# --- Database ---
# Dev (default): sqlite+aiosqlite:///./data/advert_bot.sqlite
# Prod (docker-compose): postgresql+asyncpg://advert:advert@postgres:5432/advert
DATABASE_URL=sqlite+aiosqlite:///./data/advert_bot.sqlite

# --- Observability ---
METRICS_PORT=9090
LOG_LEVEL=INFO
LOG_JSON=true

# --- UK targeting ---
UK_KEYWORDS_PATH=app/services/uk_keywords.yaml
UK_SCORE_THRESHOLD=0.55

# --- IP geolocation (optional) ---
# Free tier works without a token. Paid token raises rate limits.
IPINFO_TOKEN=
IPINFO_TTL_SECONDS=86400

# --- Google Ads (optional) ---
# Set GOOGLE_ADS_ENABLED=true only once google-ads.yaml exists and SDK is installed.
GOOGLE_ADS_ENABLED=false
GOOGLE_ADS_CONFIG_PATH=./google-ads.yaml
GOOGLE_ADS_CUSTOMER_ID=1234567890

# --- Broadcast rate limits (Telegram-safe defaults) ---
BROADCAST_RATE_GLOBAL_PER_SEC=25
BROADCAST_RATE_PER_CHAT_PER_MIN=18
